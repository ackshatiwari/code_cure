# Paper2People server-side configuration. Copy to .env.local and fill in as needed.
# Nothing here is exposed to the browser. Never prefix these with NEXT_PUBLIC_.

# Optional live analysis of pasted abstracts. Samples and all cases work without it.
ENABLE_LIVE_ANALYSIS=false
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. Effort: low | medium | high (default medium).
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
LIVE_ANALYSIS_TIMEOUT_SECONDS=90

# Rate limits for live analysis (in-memory, single process).
LIVE_RATE_LIMIT_PER_CLIENT=5
LIVE_RATE_LIMIT_DEPLOYMENT=100
LIVE_RATE_LIMIT_WINDOW_SECONDS=600

# A header your hosting platform sets to identify the client (for example x-vercel-forwarded-for).
# Leave empty to put all callers in one shared bucket. Raw x-forwarded-for is never trusted.
TRUSTED_CLIENT_ID_HEADER=

# Production safety: live analysis stays OFF in production unless one of these is set.
# hosting = platform-level rate limiting protects /api/analyze.
RATE_LIMIT_BACKEND=
# true = a private, single-instance deployment where the in-memory limiter is acceptable.
LIVE_ANALYSIS_ALLOW_IN_MEMORY_LIMITER=
